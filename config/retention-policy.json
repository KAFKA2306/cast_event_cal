{
  "schema_version": "1.0",
  "default_state": "UNCLASSIFIED",
  "rules": [
    {"class":"canonical_provenance","patterns":["data/collection_ledger/**","data/*_health.json"],"purpose":"reproducible source identity and observation provenance","authority":"canonical source/provenance contract","sensitivity":"internal_metadata","minimum_required_fields":["stable identity","observation time","decision/provenance reference"],"retention_basis":"reproducibility","eligibility":"retain"},
    {"class":"raw_source_text","patterns":["data/yahoo_realtime_candidates.json","data/x_events.json"],"purpose":"bounded parser replay and unresolved evidence","authority":"source observation input","sensitivity":"source_text","minimum_required_fields":["source identity","content hash","evidence required for replay"],"retention_basis":"active replay or unresolved resolution","eligibility":"review_for_compaction"},
    {"class":"accepted_canonical_facts","patterns":["data/manual_events.json","data/discovered_events.json","data/yahoo_realtime_events.json","data/external_events.json"],"purpose":"canonical accepted event facts","authority":"canonical event inputs","sensitivity":"public_facts","minimum_required_fields":["event identity","facts","provenance"],"retention_basis":"publication and reproducibility","eligibility":"retain"},
    {"class":"rejected_candidate_evidence","patterns":["data/yahoo_realtime_rejected.json"],"purpose":"negative evidence and classifier audit","authority":"canonical decision record","sensitivity":"source_text","minimum_required_fields":["source identity","decision","reason","evidence reference"],"retention_basis":"regression and classifier audit","eligibility":"review_for_compaction"},
    {"class":"unresolved_evidence","patterns":["data/yahoo-candidate-history.json"],"purpose":"automatic retry when new evidence arrives","authority":"observation history","sensitivity":"source_text","minimum_required_fields":["stable source identity","unresolved state","evidence reference"],"retention_basis":"active unresolved retry","eligibility":"review_for_compaction"},
    {"class":"generated_public_projection","patterns":["public/**"],"purpose":"derived public delivery surface","authority":"generated projection only","sensitivity":"public","minimum_required_fields":["derivable canonical identity"],"retention_basis":"current delivery","eligibility":"replaceable_projection"},
    {"class":"operator_audit_replay","patterns":["artifacts/**","reports/**"],"purpose":"operator audit and replay evidence","authority":"derived audit evidence","sensitivity":"operator_only","minimum_required_fields":["input identity","result","tool/version"],"retention_basis":"bounded audit history","eligibility":"review_for_compaction"},
    {"class":"ci_actions_artifact","patterns":[".github/workflows/**"],"purpose":"workflow definitions; runtime artifacts follow GitHub Actions retention separately","authority":"workflow configuration","sensitivity":"repository_metadata","minimum_required_fields":["workflow definition"],"retention_basis":"repository history","eligibility":"retain"},
    {"class":"interaction_analytics","patterns":["data/analytics/**"],"purpose":"anonymous outcome measurement when enabled","authority":"versioned analytics contract","sensitivity":"interaction_data","minimum_required_fields":["schema version","event type","observed_at"],"retention_basis":"measurement purpose only","eligibility":"review_for_compaction"}
  ]
}
